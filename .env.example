# Copy to .env (gitignored) and fill in. Loaded by docker-compose.yml and, at
# startup, by the Python scripts (extract_to_db.py, save_to_db.py, embed_claims.py).
# Exported environment variables take precedence over anything set here.

POSTGRES_USER=qgent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qgent_db

# Postgres connection for the scripts.
DATABASE_URL=postgresql://qgent:change-me@localhost:5432/qgent_db
PGPASSWORD=change-me

# Chat endpoint and key for the extraction/tagging model (glm-5.2, Compshare).
# The /v1 prefix is required: the bare host answers 404 for /chat/completions.
LLM_BASE_URL=https://cp.compshare.cn/v1
LLM_API_KEY=...

# Aliyun Bailian (DashScope) key, used for claim and chunk embeddings.
# Embeddings stay on DashScope because Compshare does not serve
# qwen3.7-text-embedding-flash. EMBEDDING_API_KEY overrides it if set.
DASHSCOPE_API_KEY=sk-...
