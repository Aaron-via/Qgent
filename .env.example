# Copy to .env (gitignored) and fill in. Loaded by docker-compose.yml and, at
# startup, by the Python scripts (extract_to_db.py, save_to_db.py, embed_claims.py).
# Exported environment variables take precedence over anything set here.

POSTGRES_USER=qgent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qgent_db

# Postgres connection for the scripts.
DATABASE_URL=postgresql://qgent:change-me@localhost:5432/qgent_db
PGPASSWORD=change-me

# DashScope key for LLM extraction and claim embeddings.
DASHSCOPE_API_KEY=sk-...
